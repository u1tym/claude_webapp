# <feature-name> の backend/.env

# 接続先DB（開発用DB。詳細は rules/13-db.md）
DB_SERVER=localhost
DB_PORT=5432
DB_DATABASE=tstdb
DB_USERNAME=tstuser
DB_PASSWORD=TSTPASS

# 許可するフロントのオリジン（カンマ区切り。* は使わない）
CORS_ORIGINS=http://localhost:5173

# デバッグ実行時のみユーザ名を指定。本番では空にする
DEBUG_USER=

# セッション有効期間（分単位。認証する場合。システムで値を揃える）
SESSION_TIMEOUT_MINUTES=60

# ログローテーション
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
