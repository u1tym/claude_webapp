# room の backend/.env のひな型（値を入れて .env として使う。.env はリポジトリに含めない）

# 接続先DB（開発用DB。詳細は rules/13-db.md）
Server=localhost
Port=5432
Database=tstdb
Username=tstuser
Password=TSTPASS

# 許可するフロントのオリジン（カンマ区切り。* は使わない）
CORS_ORIGINS=http://localhost:5185

# デバッグ実行時のみユーザ名を指定。本番では空にする
DEBUG_USER=

# セッション有効期間（分単位。システムで値を揃える）
SESSION_TIMEOUT_MINUTES=60

# ログローテーション
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# SwitchBot Web API の認証情報（アプリの開発者向けオプションで取得）
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# 機器の識別子（SwitchBot の deviceId）
ROOM_DEVICE_CEILING_LIGHT_ID=
ROOM_DEVICE_INDIRECT_LIGHT_ID=
ROOM_DEVICE_INDOOR_SPEAKER_ID=
ROOM_DEVICE_BEDSIDE_SPEAKER_ID=
ROOM_DEVICE_FRONT_DOOR_ID=

# SwitchBot への呼び出しのタイムアウト（秒。未設定なら 10）
SWITCHBOT_TIMEOUT_SECONDS=10

# 機器を切り替えたあと、実機の反映を待って状態を取り直す最大の時間（秒。未設定なら 5。0 は待たない）
# 実機は、指示してから反映されるまで少し時間がかかるため、1.5 秒おきに、目標の状態になるまで取り直す
ROOM_SETTLE_SECONDS=5

# 定期実行の起動遅れの猶予（分。未設定なら 5）
ROOM_SCHEDULE_GRACE_MINUTES=5
